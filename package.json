{
  "name": "llmessage",
  "version": "1.0.0",
  "description": "Real-time chat application — MVC architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd views && npm start",
    "build": "cd views && npm run build",
    "install:all": "npm install && cd views && npm install",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "mongodb",
    "react",
    "mvc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.6.1",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
